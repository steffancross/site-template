# Identifies this site in PostHog (used as the `site` super-property on all events).
# Must match `vars.NEXT_PUBLIC_SITE_ID` in wrangler.jsonc.
NEXT_PUBLIC_SITE_ID=site-template

# PostHog project token. Starts with `phc_`.
# Get from PostHog → Settings → Project → API Key.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

# Production base URL. Used for canonical tags, sitemap, OG tags.
# Local dev: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
